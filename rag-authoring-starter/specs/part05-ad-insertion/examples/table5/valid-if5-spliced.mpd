<?xml version="1.0" encoding="UTF-8"?>
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011"
     profiles="urn:mpeg:dash:profile:cmaf-extended:2019"
     type="dynamic"
     minimumUpdatePeriod="PT2S"
     minBufferTime="PT2S">
  <Period id="main-before" start="PT0S" data-if5-role="main">
    <AdaptationSet id="1" contentType="video">
      <Representation id="main-v1" bandwidth="1000000"/>
    </AdaptationSet>
  </Period>
  <Period id="ad-1" start="PT60S" availabilityTimeOffset="4" data-if5-role="ad">
    <BaseURL>https://example.com/ad/</BaseURL>
    <AssetIdentifier schemeIdUri="http://dashif.org/guidelines/v5/asset-id" value="urn:example:ad:1"/>
    <AdaptationSet id="2" contentType="video">
      <Representation id="ad-v1" bandwidth="900000"/>
    </AdaptationSet>
  </Period>
  <Period id="main-after" start="PT90S" data-if5-role="main">
    <AdaptationSet id="3" contentType="video">
      <Representation id="main-v2" bandwidth="1000000"/>
    </AdaptationSet>
  </Period>
</MPD>